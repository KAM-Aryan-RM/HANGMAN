import random

words = ["football", "basketball", "tennis", "swimming", "cricket", "golf" , "boxing" , "rugby"]

word = random.choice(words)
guessed = []
Wrong_guess_count = 0
max_attempts = 6

hangman = [
    """
     -----
     |   |
         |
         |
         |
    =========
    """,
    """
     -----
     |   |
     O   |
         |
         |
    =========
    """,
    """
     -----
     |   |
     O   |
     |   |
         |
    =========
    """,
    """
     -----
     |   |
     O   |
    /|   |
         |
    =========
    """,
     """
      -----
      |   |
      O   |
     /|\\  |
          |
        =========
        """
        ,
    """
     -----
     |   |
     O   |
    /|\\ |
    /    |
    =========
    """,
    """
     -----
     |   |
     O   |
    /|\\  |
    / \\ |
    =========
    """
]

print("Welcome to Hangman Game!")
print("Hint: The word is a Sport.")

while Wrong_guess_count < max_attempts:

    display = ""

    for letter in word:
        if letter in guessed:
            display += letter + " "
        else:
            display += "_ "

    print(hangman[Wrong_guess_count])
    print("Word:", display)

    if "_" not in display:
        print("Congratulations! You won the Game🎉.")
        print("The Sport was:", word)
        print("Never tried this sport before? There is no better time than now!")
        break

    guess = input("Guess a letter: ").lower()

    if len(guess) != 1 or not guess.isalpha():
        print("Please enter one letter.")
        continue

    if guess in guessed:
        print('''You already guessed this letter.
        Try another letter.''')
        continue

    guessed.append(guess)

    if guess in word:
        print("Correct guess!")
    else:
        Wrong_guess_count += 1
        print("Wrong guess!")

else:
    print(hangman[Wrong_guess_count])
    print("Game Over!🙈")
    print("The Sport was:", word)
    print("Never give up! Every defeat is a lesson on the road to victory.")

